# "mock" runs the whole UI on local fixtures. "supabase" uses the real backend.
NEXT_PUBLIC_DATA_MODE=mock

# Supabase (public, safe in the browser; RLS protects user rows)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put ANTHROPIC_API_KEY or ZONING_API_KEY here.
# They live only in Supabase Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... ZONING_API_KEY=...
